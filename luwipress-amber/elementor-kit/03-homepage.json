     "elements": [
      {
       "id": "fbd0000c",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"section activities\" id=\"activities\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"row\">\n        <div>\n          <span class=\"eyebrow\">Top Activities in Dubai</span>\n          <h2 class=\"h2\">The best adventures <em>Dubai has to offer</em></h2>\n        </div>\n        <div class=\"act-nav\">\n          <button id=\"actPrev\" aria-label=\"Previous\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M15 18l-6-6 6-6\"/></svg></button>\n          <button id=\"actNext\" aria-label=\"Next\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M9 6l6 6-6 6\"/></svg></button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"act-scroller\" id=\"actScroller\">\n\n    <article class=\"act-card\">\n      <div class=\"scene scene-sky-city\" style=\"position:absolute;inset:0;\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/heli.jpg\" alt=\"Helicopter tour over Dubai\" loading=\"lazy\"></div>\n      <div class=\"act-scrim\"></div>\n      <div class=\"act-top\">\n        <span class=\"chip price\">From AED 1,450</span>\n        <span class=\"chip\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>17 min</span>\n      </div>\n      <div class=\"act-body\">\n        <span class=\"tag\">Aerial</span>\n        <h3>Helicopter Tours</h3>\n        <p>Bank over the Palm and Burj Khalifa at golden hour — Dubai's skyline from the only seat that counts.</p>\n        <a href=\"#\" class=\"book\">Book <svg class=\"arrow\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n    </article>\n\n    <article class=\"act-card\">\n      <div class=\"scene scene-dunes\" style=\"position:absolute;inset:0;\"><div class=\"scene-sky\"></div><div class=\"scene-sun\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/desert-safari.jpg\" alt=\"Desert safari at sunset\" loading=\"lazy\"></div>\n      <div class=\"act-scrim\"></div>\n      <div class=\"act-top\">\n        <span class=\"chip price\">From AED 240</span>\n        <span class=\"chip\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>6 hrs</span>\n      </div>\n      <div class=\"act-body\">\n        <span class=\"tag\">Desert</span>\n        <h3>Desert Safari</h3>\n        <p>Dune-bash the red sands, then dine under the stars with falconry, fire and the quiet of the open desert.</p>\n        <a href=\"#\" class=\"book\">Book <svg class=\"arrow\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n    </article>\n\n    <article class=\"act-card\">\n      <div class=\"scene scene-sea-day\" style=\"position:absolute;inset:0;\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/YAHT.jpg\" alt=\"Private yacht tour on the Dubai Marina\" loading=\"lazy\"></div>\n      <div class=\"act-scrim\"></div>\n      <div class=\"act-top\">\n        <span class=\"chip price\">From AED 600</span>\n        <span class=\"chip\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>3 hrs</span>\n      </div>\n      <div class=\"act-body\">\n        <span class=\"tag\">Marina</span>\n        <h3>Yacht Tour</h3>\n        <p>Cut warm Gulf water past the Marina and Ain Dubai on a private charter — sundowners optional, views guaranteed.</p>\n        <a href=\"#\" class=\"book\">Book <svg class=\"arrow\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n    </article>\n\n    <article class=\"act-card\">\n      <div class=\"scene scene-sky-city\" style=\"position:absolute;inset:0;\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/BURRJ.jpg\" alt=\"Burj Khalifa at dusk\" loading=\"lazy\"></div>\n      <div class=\"act-scrim\"></div>\n      <div class=\"act-top\">\n        <span class=\"chip price\">From AED 169</span>\n        <span class=\"chip\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>2 hrs</span>\n      </div>\n      <div class=\"act-body\">\n        <span class=\"tag\">Iconic</span>\n        <h3>Burj Khalifa</h3>\n        <p>Rise to the world's highest observation deck for the city laid out in light — booked at the perfect hour.</p>\n        <a href=\"#\" class=\"book\">Book <svg class=\"arrow\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n    </article>\n\n  </div>\n  <div class=\"wrap\" style=\"margin-top:30px;\">\n    <a href=\"#\" class=\"text-link\">View All Activities\n      <svg class=\"arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n    </a>\n  </div>\n</section>"
       }
      }
     ]
    }
   ]
  },
