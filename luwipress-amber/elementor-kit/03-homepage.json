      {
       "id": "fbd00009",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"section\" id=\"services\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"row\">\n        <div>\n          <span class=\"eyebrow\">Our Services</span>\n          <h2 class=\"h2\">Everything for your <em>Dubai journey</em></h2>\n        </div>\n        <a href=\"#\" class=\"text-link\">View All Services\n          <svg class=\"arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n      </div>\n    </div>\n    <div class=\"services-grid\">\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-warm-int\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/visa.jpg\" alt=\"Dubai visa services\" loading=\"lazy\"><span class=\"scene-label\">Visa</span></div>\n        <div class=\"body\">\n          <h3>Visa Services</h3>\n          <p>Tourist visa assistance with the right deal and fast, guided processing — no guesswork.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-sea\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/car.jpg\" alt=\"Private transport in Dubai\" loading=\"lazy\"><span class=\"scene-label\">Transport</span></div>\n        <div class=\"body\">\n          <h3>Transport Services</h3>\n          <p>Airport and city transfers in private chauffeured comfort, on your schedule.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-sky-city\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/muse.jpg\" alt=\"Dubai attraction tickets\" loading=\"lazy\"><span class=\"scene-label\">Tickets</span></div>\n        <div class=\"body\">\n          <h3>Tour Tickets</h3>\n          <p>Skip-the-line access to Dubai's headline attractions, museums and observation decks.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-dunes\"><div class=\"scene-sky\"></div><div class=\"scene-sun\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/excu.jpg\" alt=\"Dubai excursions\" loading=\"lazy\"><span class=\"scene-label\">Excursions</span></div>\n        <div class=\"body\">\n          <h3>Excursions</h3>\n          <p>Desert safaris, dune dinners and guided day trips beyond the city skyline.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-sky-city\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/mice.jpg\" alt=\"MICE events in Dubai\" loading=\"lazy\"><span class=\"scene-label\">MICE</span></div>\n        <div class=\"body\">\n          <h3>MICE Events</h3>\n          <p>Meetings, incentives and conferences staged with venues, logistics and flair.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n      <div class=\"svc\">\n        <div class=\"photo scene scene-sea\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/burj.jpg\" alt=\"Dubai tour packages\" loading=\"lazy\"><span class=\"scene-label\">Packages</span></div>\n        <div class=\"body\">\n          <h3>Tour Packages</h3>\n          <p>End-to-end itineraries for individuals, families and groups — designed around you.</p>\n          <a href=\"#\" class=\"more\">Learn more <svg class=\"arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>"
       }
      }
     ]
    }
   ]
