     "elements": [
      {
       "id": "fbd0000f",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"section\" id=\"about\">\n  <div class=\"wrap\">\n    <div class=\"about-grid\">\n      <div class=\"about-media\">\n        <div class=\"scene scene-warm-int\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/burj.jpg\" alt=\"Fly By Deniz Dubai travel experiences\" loading=\"lazy\"><span class=\"scene-label\">Lifestyle</span></div>\n        <div class=\"float-card\">\n          <div class=\"num\">100%</div>\n          <div class=\"lbl\">Tailored to individuals, families & groups</div>\n        </div>\n      </div>\n      <div class=\"about-copy\">\n        <span class=\"eyebrow\">About Us</span>\n        <h2>A travel agency that handles the details — so you don't.</h2>\n        <p>Fly By Deniz is a Dubai-based travel agency providing expert services for travellers from all over the world. With years of experience in tourism, we offer tailored solutions for individual guests, families and groups.</p>\n        <p>Our services span tourist visa assistance, tour packages, hotel reservations, airport and city transfers, flight bookings, and private guided tours. Every journey is designed for comfort, reliability and a genuinely memorable experience — premium service with local insight and international standards.</p>\n        <div class=\"sig\">\n          <span class=\"av\" style=\"background:linear-gradient(135deg,#F0C277,#C9572F)\">A</span>\n          <span>\n            <div class=\"nm\">Ayhan</div>\n            <div class=\"ro\">Founder, Fly By Deniz Tourism LLC</div>\n          </span>\n        </div>\n        <div style=\"margin-top:26px;\">\n          <a href=\"#\" class=\"btn btn--ghost\">Know More\n            <svg class=\"arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
       }
      }
     ]
    }
   ]
  },
