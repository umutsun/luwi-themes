      {
       "id": "fbd00006",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"trust section--tight\">\n  <div class=\"wrap\">\n    <div class=\"trust-head\">\n      <span class=\"eyebrow\">Why Fly By Deniz</span>\n      <h2 class=\"trust-statement\">A Dubai-based agency turning first visits and returning adventures into <em>effortless, memorable journeys.</em></h2>\n    </div>\n    <div class=\"trust-cards\">\n      <div class=\"tcard\">\n        <span class=\"idx\">01</span>\n        <span class=\"tc-ic\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span>\n        <h3>Seasoned specialists</h3>\n        <p>Years of on-the-ground Dubai expertise behind every itinerary.</p>\n      </div>\n      <div class=\"tcard\">\n        <span class=\"idx\">02</span>\n        <span class=\"tc-ic\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"m12 2 2.4 7.3H22l-6 4.5 2.3 7.2L12 16.5 5.7 21l2.3-7.2-6-4.5h7.6L12 2Z\"/></svg></span>\n        <h3>Hand-picked only</h3>\n        <p>Every experience is one we&rsquo;d happily book ourselves.</p>\n      </div>\n      <div class=\"tcard\">\n        <span class=\"idx\">03</span>\n        <span class=\"tc-ic\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z\"/></svg></span>\n        <h3>Local insight, global standards</h3>\n        <p>On the ground daily, delivered to international standards.</p>\n      </div>\n      <div class=\"tcard\">\n        <span class=\"idx\">04</span>\n        <span class=\"tc-ic\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.5 8.5 0 1 1 21 11.5Z\"/></svg></span>\n        <h3>24/7 concierge</h3>\n        <p>Reachable on WhatsApp around the clock, every day of your stay.</p>\n      </div>\n    </div>\n  </div>\n</section>"
       }
      }
     ]
    }
   ]
  },
