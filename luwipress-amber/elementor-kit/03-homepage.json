        "html": "<section class=\"section\" id=\"gallery\">\n  <div class=\"wrap\">\n    <div class=\"sec-head center\">\n      <span class=\"eyebrow centered\">Moments</span>\n      <h2 class=\"h2\">A Dubai reel, <em>frame by frame</em></h2>\n    </div>\n    <div class=\"gallery-grid\">\n      <div class=\"g-tile g-big scene scene-dunes\"><div class=\"scene-sky\"></div><div class=\"scene-sun\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/desert-safari.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div><span class=\"g-cap\">Desert at golden hour</span></div>\n      <div class=\"g-tile scene scene-sea-day\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/YAHT.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div><span class=\"g-cap\">Marina afternoon</span></div>\n      <div class=\"g-tile scene scene-sky-city\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/BURRJ.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div><span class=\"g-cap\">Skyline at dusk</span></div>\n      <div class=\"g-tile g-wide scene scene-sky-city\"><div class=\"scene-sky\"></div><div class=\"scene-city-band\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/BURRJ.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div><span class=\"g-cap\">Downtown lights</span></div>\n      <div class=\"g-tile scene scene-warm-int\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/muse.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div><span class=\"g-cap\">City moments</span></div>\n      <div class=\"g-tile scene scene-dunes\"><div class=\"scene-sky\"></div><div class=\"scene-sun\"></div><img class=\"scene-img\" src=\"https:/