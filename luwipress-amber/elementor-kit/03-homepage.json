        "html": "<section class=\"section ctaband\">\n  <div class=\"scene scene-sea\"><div class=\"scene-sky\"></div><img class=\"scene-img\" src=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/BURRJ.jpg\" alt=\"\" loading=\"lazy\"><div class=\"scene-scrim\"></div></div>\n  <div class=\"wrap\">\n    <span class=\"eyebrow centered\">Start the journey</span>\n    <h2>Your Dubai adventure <em>starts here</em></h2>\n    <div class=\"cta-row\">\n      <a href=\"#contact\" class=\"btn btn--amber\">Plan My Trip\n        <svg class=\"arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      </a>\n      <a href=\"#\" class=\"btn btn--wa\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.2Z\"/></svg>\n        WhatsApp Us\n      </a>\n    </div>\n  </div>\n</section>"
