      {
       "id": "fbd00003",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<section class=\"hero\">\n  <div class=\"scene\" style=\"position:absolute;inset:0;\">\n    <div class=\"scene-sky\"></div>\n    <div class=\"scene-sun\"></div>\n    <div class=\"scene-dunes\" style=\"position:absolute;inset:0;\"></div>\n    <video class=\"scene-video\" autoplay muted loop playsinline preload=\"auto\" poster=\"https://www.flybydeniz.com/wp-content/uploads/2025/06/heli.jpg\"></video>\n    <div class=\"scene-scrim\"></div>\n  </div>\n  <div class=\"wrap\">\n    <span class=\"eyebrow\">Welcome to Fly By Deniz</span>\n    <h1>Unforgettable Dubai, <em>effortlessly</em> yours.</h1>\n    <p class=\"sub\">Curated adventures and seamless travel — visas, transfers, private tours and the moments in between, handled end to end by your Dubai concierge.</p>\n    <div class=\"cta-row\">\n      <a href=\"#contact\" class=\"btn btn--amber\">Plan My Trip\n        <svg class=\"arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      </a>\n      <a href=\"#activities\" class=\"btn btn--ghost\">Explore Experiences</a>\n    </div>\n    <!-- booking bar -->\n    <div class=\"bookbar\">\n      <div class=\"field\">\n        <div class=\"lbl\">Experience</div>\n        <div class=\"val\">Desert Safari\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M6 9l6 6 6-6\"/></svg>\n        </div>\n      </div>\n      <div class=\"field\">\n        <div class=\"lbl\">Date</div>\n        <div class=\"val\">Add dates</div>\n      </div>\n      <div class=\"field\">\n        <div class=\"lbl\">Guests</div>\n        <div class=\"val\">2 travellers</div>\n      </div>\n      <button class=\"go\" aria-label=\"Search\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n      </button>\n    </div>\n  </div>\n  <div class=\"scroll-hint\"><span>Scroll</span><span class=\"line\"></span></div>\n</section>"
       }
      }
     ]
    }
   ]
