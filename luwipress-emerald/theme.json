{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "name": "Primary (Emerald)", "slug": "primary",       "color": "#047857" },
        { "name": "Primary Hover",     "slug": "primary-hover", "color": "#065F46" },
        { "name": "Primary Soft",      "slug": "primary-soft",  "color": "#ECFDF5" },
        { "name": "Ink",           "slug": "ink",           "color": "#0F172A" },
        { "name": "Ink Soft",      "slug": "ink-soft",      "color": "#334155" },
        { "name": "Muted",         "slug": "muted",         "color": "#64748B" },
        { "name": "Surface Alt",   "slug": "surface-alt",   "color": "#F8FAFC" },
        { "name": "Line",          "slug": "line",          "color": "#E2E8F0" },
        { "name": "Success",       "slug": "success",       "color": "#0D9F6E" },
        { "name": "Sale",          "slug": "sale",          "color": "#DC2626" },
        { "name": "White",         "slug": "white",         "color": "#FFFFFF" }
      ],
      "custom": true,
      "customDuotone": false,
      "customGradient": false
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "name": "JetBrains Mono",
          "slug": "mono",
          "fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
        }
      ],
      "fontSizes": [
        { "name": "Small",   "slug": "small",   "size": "14px" },
        { "name": "Regular", "slug": "regular", "size": "16px" },
        { "name": "Medium",  "slug": "medium",  "size": "18px" },
        { "name": "Large",   "slug": "large",   "size": "22px" },
        { "name": "XL",      "slug": "x-large", "size": "32px" }
      ],
      "customFontSize": true,
      "fontWeight": true,
      "fontStyle": true,
      "letterSpacing": true,
      "lineHeight": true
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#0F172A"
    },
    "typography": {
      "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": "16px",
      "lineHeight": "1.55"
    }
  }
}
