{
  "version": "0.4",
  "title": "LuwiPress Gold — Animations & Loading",
  "type": "section",
  "content": [
    {
      "id": "lwp_anim_section",
      "elType": "section",
      "settings": {
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
      },
      "elements": [
        {
          "id": "lwp_anim_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "lwp_anim_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- LuwiPress Gold · Page loader + scroll reveal + skeleton + micro-interactions -->\n<div id=\"lwp-loader\" class=\"lwp-loader\" aria-hidden=\"true\">\n  <div class=\"lwp-loader-inner\">\n    <svg class=\"lwp-loader-mark\" viewBox=\"0 0 60 60\" width=\"60\" height=\"60\" aria-hidden=\"true\">\n      <circle cx=\"30\" cy=\"30\" r=\"26\" fill=\"none\" stroke=\"#E8DFC8\" stroke-width=\"2\"/>\n      <circle class=\"lwp-loader-arc\" cx=\"30\" cy=\"30\" r=\"26\" fill=\"none\" stroke=\"#9A7B3A\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-dasharray=\"40 200\"/>\n      <text x=\"30\" y=\"38\" text-anchor=\"middle\" font-family=\"Cormorant Garamond, serif\" font-style=\"italic\" font-size=\"28\" fill=\"#9A7B3A\" font-weight=\"500\">T</text>\n    </svg>\n    <span class=\"lwp-loader-text\">Tuning the page</span>\n    <span class=\"lwp-loader-bar\"><span></span></span>\n  </div>\n</div>\n\n<style>\n/* ============================================================\n   LuwiPress Gold · global animation layer\n   Drop this widget once at the very top of the page (or inject\n   via wp_footer hook) — it owns: page loader, scroll-reveal,\n   skeletons, hover micro-interactions.\n   ============================================================ */\n\n/* —— 1. Page loader —— */\n.lwp-loader{position:fixed;inset:0;z-index:99999;background:#FAF6EE;display:flex;align-items:center;justify-content:center;transition:opacity .55s ease,visibility .55s ease}\n.lwp-loader.lwp-loaded{opacity:0;visibility:hidden;pointer-events:none}\n.lwp-loader-inner{display:flex;flex-direction:column;align-items:center;gap:18px}\n.lwp-loader-mark{animation:lwp-spin 1.4s linear infinite}\n.lwp-loader-arc{transform-origin:center;animation:lwp-arc 1.6s ease-in-out infinite}\n.lwp-loader-text{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8b7f6a}\n.lwp-loader-bar{width:120px;height:2px;background:#E8DFC8;border-radius:2px;overflow:hidden;display:block}\n.lwp-loader-bar span{display:block;height:100%;background:linear-gradient(90deg,#9A7B3A,#D4AF37);width:30%;border-radius:2px;animation:lwp-bar 1.4s ease-in-out infinite}\n@keyframes lwp-spin{to{transform:rotate(360deg)}}\n@keyframes lwp-arc{0%,100%{stroke-dasharray:8 200;stroke-dashoffset:0}50%{stroke-dasharray:60 200;stroke-dashoffset:-30}}\n@keyframes lwp-bar{0%{transform:translateX(-120%)}100%{transform:translateX(420%)}}\n\n/* —— 2. Scroll-reveal —— */\n[data-lwp-reveal]{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}\n[data-lwp-reveal].in{opacity:1;transform:none}\n[data-lwp-reveal=\"left\"]{transform:translateX(-32px)}\n[data-lwp-reveal=\"left\"].in{transform:none}\n[data-lwp-reveal=\"right\"]{transform:translateX(32px)}\n[data-lwp-reveal=\"right\"].in{transform:none}\n[data-lwp-reveal=\"scale\"]{transform:scale(.96)}\n[data-lwp-reveal=\"scale\"].in{transform:scale(1)}\n[data-lwp-stagger] > *{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1)}\n[data-lwp-stagger].in > *{opacity:1;transform:none}\n[data-lwp-stagger].in > *:nth-child(1){transition-delay:.05s}\n[data-lwp-stagger].in > *:nth-child(2){transition-delay:.12s}\n[data-lwp-stagger].in > *:nth-child(3){transition-delay:.19s}\n[data-lwp-stagger].in > *:nth-child(4){transition-delay:.26s}\n[data-lwp-stagger].in > *:nth-child(5){transition-delay:.33s}\n[data-lwp-stagger].in > *:nth-child(6){transition-delay:.40s}\n[data-lwp-stagger].in > *:nth-child(7){transition-delay:.47s}\n[data-lwp-stagger].in > *:nth-child(8){transition-delay:.54s}\n\n/* —— 3. Skeleton placeholders for image-bg blocks —— */\n.lwp-skel{position:relative;overflow:hidden;background:#f0e6d0}\n.lwp-skel::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);transform:translateX(-100%);animation:lwp-shimmer 1.8s infinite}\n@keyframes lwp-shimmer{100%{transform:translateX(100%)}}\n.lwp-skel-text{height:14px;background:#f0e6d0;border-radius:3px;margin:6px 0;position:relative;overflow:hidden}\n.lwp-skel-text::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.6),transparent);transform:translateX(-100%);animation:lwp-shimmer 1.8s infinite}\n.lwp-skel-text.w-60{width:60%}\n.lwp-skel-text.w-40{width:40%}\n.lwp-skel-text.w-80{width:80%}\n\n/* —— 4. Image fade-in on load —— */\nimg[data-lwp-fade]{opacity:0;transition:opacity .6s ease}\nimg[data-lwp-fade].loaded{opacity:1}\n\n/* —— 5. Hover lift utility (already used in header/footer/cards) —— */\n.lwp-lift{transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease}\n.lwp-lift:hover{transform:translateY(-4px)}\n\n/* —— 6. Underline-grow link (replaces border-bottom static links) —— */\n.lwp-ulink{position:relative;text-decoration:none;color:inherit;display:inline-block;padding-bottom:2px}\n.lwp-ulink::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .35s cubic-bezier(.2,.7,.2,1)}\n.lwp-ulink:hover::after{transform:scaleX(1);transform-origin:left}\n\n/* —— 7. Cart bounce on add —— */\n@keyframes lwp-cart-bounce{0%,100%{transform:scale(1)}30%{transform:scale(1.25)}60%{transform:scale(.92)}}\n.lwp-cart-bump{animation:lwp-cart-bounce .55s ease}\n\n/* —— 8. Reduced motion —— */\n@media (prefers-reduced-motion: reduce){\n  .lwp-loader,.lwp-loader-mark,.lwp-loader-arc,.lwp-loader-bar span{animation:none !important}\n  [data-lwp-reveal],[data-lwp-stagger] > *{opacity:1 !important;transform:none !important;transition:none !important}\n  .lwp-skel::after,.lwp-skel-text::after{animation:none !important}\n}\n</style>\n\n<script>\n(function(){\n  /* ---- Loader: hide once page is ready ---- */\n  function hideLoader(){\n    var l=document.getElementById('lwp-loader');\n    if(l) setTimeout(function(){l.classList.add('lwp-loaded')}, 250);\n  }\n  if(document.readyState==='complete') hideLoader();\n  else window.addEventListener('load', hideLoader);\n  /* Failsafe — never block the page > 4s */\n  setTimeout(hideLoader, 4000);\n\n  /* ---- Scroll reveal ---- */\n  if('IntersectionObserver' in window){\n    var io=new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}\n      });\n    },{rootMargin:'0px 0px -10% 0px',threshold:.08});\n    function observeAll(){\n      document.querySelectorAll('[data-lwp-reveal], [data-lwp-stagger]').forEach(function(el){\n        if(!el.classList.contains('in')) io.observe(el);\n      });\n    }\n    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', observeAll);\n    else observeAll();\n    /* Re-scan on Elementor frontend re-init */\n    document.addEventListener('elementor/frontend/init', observeAll);\n  } else {\n    /* No IO support — show everything */\n    document.querySelectorAll('[data-lwp-reveal], [data-lwp-stagger]').forEach(function(el){el.classList.add('in')});\n  }\n\n  /* ---- Image fade-in ---- */\n  document.querySelectorAll('img[data-lwp-fade]').forEach(function(img){\n    if(img.complete) img.classList.add('loaded');\n    else img.addEventListener('load', function(){img.classList.add('loaded')});\n  });\n\n  /* ---- Cart bump on WooCommerce added_to_cart ---- */\n  if(window.jQuery){\n    jQuery(document.body).on('added_to_cart', function(){\n      document.querySelectorAll('.lwp-cart-icon, .tap-cart-icon').forEach(function(el){\n        el.classList.remove('lwp-cart-bump');\n        void el.offsetWidth;\n        el.classList.add('lwp-cart-bump');\n      });\n    });\n  }\n})();\n</script>"
              }
            }
          ]
        }
      ]
    }
  ],
  "page_settings": {}
}
