          "settings": { "_column_size": 50, "content_position": "center", "_inline_size": 55, "css_classes": "tap-nav-col" },
          "elements": [
            {
              "id": "tap_nav",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<nav class=\"tap-nav\" id=\"tapNav\">\n  <div class=\"tap-nav-item\" data-mega=\"string\"><a href=\"/category/string\">String</a></div>\n  <div class=\"tap-nav-item\" data-mega=\"perc\"><a href=\"/category/percussions\">Percussions</a></div>\n  <div class=\"tap-nav-item\" data-mega=\"bowed\"><a href=\"/category/bowed\">Bowed</a></div>\n  <div class=\"tap-nav-item\" data-mega=\"winds\"><a href=\"/category/winds\">Winds</a></div>\n  <div class=\"tap-nav-item\"><a href=\"/category/accessories\">Accessories</a></div>\n  <div class=\"tap-nav-item\"><a href=\"/customs\">Customs</a></div>\n  <div class=\"tap-nav-item\"><a href=\"/academy\">Academy</a></div>\n  <div class=\"tap-nav-item\"><a href=\"/blog\">Blog</a></div>\n</nav>\n\n<div class=\"tap-mega-wrap\" id=\"tapMegaWrap\">\n  <div class=\"tap-mega\" data-mega-panel=\"string\">\n    <div class=\"tap-mega-inner\">\n      <div class=\"tap-mega-col\"><h5>Plucked</h5><ul><li><a href=\"/category/arabic-oud\">Arabic Oud</a></li><li><a href=\"/category/turkish-oud\">Turkish Oud</a></li><li><a href=\"/category/electric-oud\">Electric Oud</a></li><li><a href=\"/category/bouzouki\">Bouzouki</a></li><li><a href=\"/category/lavta\">Lavta</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Long-neck</h5><ul><li><a href=\"/category/saz-baglama\">Saz / Baglama</a></li><li><a href=\"/category/setar\">Setar</a></li><li><a href=\"/category/tanbur\">Tanbur</a></li><li><a href=\"/category/caglama\">Caglama</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Struck &amp; plucked</h5><ul><li><a href=\"/category/santur\">Santur</a></li><li><a href=\"/category/qanun\">Qanun</a></li></ul></div>\n      <a class=\"tap-mega-feat\" href=\"/product/sultan-turkish-oud\"><div class=\"tap-mega-feat-img\" style=\"background:linear-gradient(135deg,#d4b97a,#7a5a2c)\"><span>Master pick</span></div><div class=\"tap-mega-feat-meta\"><span class=\"eb\">Featured</span><span class=\"tt\">Sultan Turkish Oud</span><span class=\"lk\">Shop oud collection →</span></div></a>\n    </div>\n  </div>\n  <div class=\"tap-mega\" data-mega-panel=\"perc\">\n    <div class=\"tap-mega-inner\">\n      <div class=\"tap-mega-col\"><h5>Darbuka</h5><ul><li><a href=\"/category/clay-darbuka\">Clay Darbuka</a></li><li><a href=\"/category/aluminum-darbuka\">Pro Aluminum</a></li><li><a href=\"/category/travel-darbuka\">Travel Darbuka</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Frame drums</h5><ul><li><a href=\"/category/bendir\">Bendir</a></li><li><a href=\"/category/riq\">Riq</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Tuned</h5><ul><li><a href=\"/category/handpan\">Handpan</a></li><li><a href=\"/category/steel-tongue\">Steel Tongue</a></li></ul></div>\n      <a class=\"tap-mega-feat\" href=\"/product/tapadum-pro-12\"><div class=\"tap-mega-feat-img\" style=\"background:linear-gradient(135deg,#3d2f1f,#7a5a2c)\"><span>New</span></div><div class=\"tap-mega-feat-meta\"><span class=\"eb\">Just landed</span><span class=\"tt\">Tapadum Pro 12 Notes</span><span class=\"lk\">Shop handpan →</span></div></a>\n    </div>\n  </div>\n  <div class=\"tap-mega\" data-mega-panel=\"bowed\">\n    <div class=\"tap-mega-inner\">\n      <div class=\"tap-mega-col\"><h5>Kemence</h5><ul><li><a href=\"/category/black-sea-kemence\">Black Sea Kemence</a></li><li><a href=\"/category/classical-kemence\">Classical Kemence</a></li><li><a href=\"/category/kamancheh\">Persian Kamancheh</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Other bowed</h5><ul><li><a href=\"/category/kabak-kemane\">Kabak Kemane</a></li></ul></div>\n      <a class=\"tap-mega-feat\" href=\"/blog/voice-of-kemence\"><div class=\"tap-mega-feat-img\" style=\"background:linear-gradient(135deg,#5a3a2a,#c89a5a)\"><span>Story</span></div><div class=\"tap-mega-feat-meta\"><span class=\"eb\">Journal</span><span class=\"tt\">The voice of the kemence</span><span class=\"lk\">Read →</span></div></a>\n    </div>\n  </div>\n  <div class=\"tap-mega\" data-mega-panel=\"winds\">\n    <div class=\"tap-mega-inner\">\n      <div class=\"tap-mega-col\"><h5>Reed &amp; flute</h5><ul><li><a href=\"/category/ney\">Ney</a></li><li><a href=\"/category/duduk\">Duduk</a></li><li><a href=\"/category/kaval\">Kaval</a></li></ul></div>\n      <div class=\"tap-mega-col\"><h5>Double reed</h5><ul><li><a href=\"/category/mey\">Mey</a></li><li><a href=\"/category/zurna\">Zurna</a></li></ul></div>\n      <a class=\"tap-mega-feat\" href=\"/blog/healing-ney\"><div class=\"tap-mega-feat-img\" style=\"background:linear-gradient(135deg,#2a3d3a,#7aa494)\"><span>Long read</span></div><div class=\"tap-mega-feat-meta\"><span class=\"eb\">Journal</span><span class=\"tt\">Healing effects of the ney</span><span class=\"lk\">Read →</span></div></a>\n    </div>\n  </div>\n</div>\n\n<style>\n.tap-nav{display:flex;gap:28px;justify-content:center;align-items:center}\n.tap-nav-item{position:relative}\n.tap-nav-item > a{font-family:'Inter',sans-serif;font-size:14px;font-weight:500;color:#1A1612;text-decoration:none;padding:8px 0;display:inline-flex;align-items:center;gap:6px;transition:color .15s}\n.tap-nav-item[data-mega] > a::after{content:'›';display:inline-block;transform:rotate(90deg);font-size:11px;color:#8b7f6a}\n.tap-nav-item:hover > a{color:#9A7B3A}\n.tap-mega-wrap{position:absolute;left:0;right:0;top:100%;background:#fff;border-top:1px solid #E8DFC8;box-shadow:0 24px 48px -16px rgba(0,0,0,.18);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .22s ease, transform .22s ease, visibility .22s;z-index:90}\n.tap-mega-wrap.open{opacity:1;visibility:visible;transform:translateY(0)}\n.tap-mega{display:none}\n.tap-mega.show{display:block}\n.tap-mega-inner{max-width:1372px;margin:0 auto;padding:36px 32px 40px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) 320px;gap:48px;text-align:left}\n.tap-mega-col h5{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#8b7f6a;font-weight:600;margin:0 0 14px;border-bottom:1px solid #E8DFC8;padding-bottom:10px}\n.tap-mega-col ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}\n.tap-mega-col a{display:block;text-decoration:none;color:#1A1612;font-size:14px;padding:4px 0;transition:color .15s, padding .15s}\n.tap-mega-col a:hover{color:#9A7B3A;padding-left:6px}\n.tap-mega-feat{display:flex;flex-direction:column;text-decoration:none;color:#1A1612;border-radius:10px;overflow:hidden;background:#FAF6EE;border:1px solid #E8DFC8;transition:transform .25s ease, box-shadow .25s ease}\n.tap-mega-feat:hover{transform:translateY(-3px);box-shadow:0 12px 24px -10px rgba(0,0,0,.18)}\n.tap-mega-feat-img{height:180px;display:flex;align-items:flex-end;padding:14px}\n.tap-mega-feat-img span{font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:#fff;background:rgba(0,0,0,.3);padding:4px 10px;border-radius:20px}\n.tap-mega-feat-meta{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px}\n.tap-mega-feat-meta .eb{font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.18em;color:#8b7f6a}\n.tap-mega-feat-meta .tt{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:500}\n.tap-mega-feat-meta .lk{font-size:12px;color:#9A7B3A;margin-top:6px;font-weight:600}\n@media(max-width:1024px){.tap-nav{display:none}.tap-mega-wrap{display:none}}\n</style>\n\n<script>\n(function(){\n  const wrap=document.getElementById('tapMegaWrap');\n  if(!wrap||wrap.dataset.bound)return;wrap.dataset.bound='1';\n  let t;\n  document.querySelectorAll('.tap-nav-item[data-mega]').forEach(it=>{\n    it.addEventListener('mouseenter',()=>{clearTimeout(t);document.querySelectorAll('.tap-mega').forEach(m=>m.classList.toggle('show',m.dataset.megaPanel===it.dataset.mega));wrap.classList.add('open');});\n    it.addEventListener('mouseleave',()=>{t=setTimeout(()=>wrap.classList.remove('open'),120);});\n    it.querySelector('a').addEventListener('click',e=>e.preventDefault());\n  });\n  wrap.addEventListener('mouseenter',()=>clearTimeout(t));\n  wrap.addEventListener('mouseleave',()=>{t=setTimeout(()=>wrap.classList.remove('open'),120);});\n  // sticky shrink\n  const hdr=document.querySelector('.tap-header-main');\n  if(hdr){window.addEventListener('scroll',()=>{hdr.classList.toggle('shrunk',window.scrollY>80);},{passive:true});}\n})();\n</script>"
              }
            }
          ]
        },
