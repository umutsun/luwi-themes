              "settings": {
                "html": "<div class=\"tap-overlay\" id=\"tapSearchOverlay\" onclick=\"if(event.target===this)tapCloseSearch()\">\n  <div class=\"tap-search-panel\">\n    <button class=\"tap-close-btn\" onclick=\"tapCloseSearch()\" aria-label=\"Close\">×</button>\n    <div class=\"tap-search-eyebrow\">Search Tapadum</div>\n    <div class=\"tap-search-input-wrap\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b7f6a\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n      <input type=\"text\" id=\"tapSearchInput\" placeholder=\"Try 'turkish oud', 'handpan d hicaz', 'ney'…\" autocomplete=\"off\" />\n    </div>\n    <div class=\"tap-search-suggest\">\n      <div class=\"tap-sugg-block\"><div class=\"tap-sugg-label\">Trending</div><div class=\"tap-sugg-chips\"><a href=\"/?s=turkish+oud\">Turkish Oud</a><a href=\"/?s=handpan\">Handpan</a><a href=\"/?s=clay+darbuka\">Clay Darbuka</a><a href=\"/?s=ney\">Ney</a><a href=\"/?s=setar\">Setar</a></div></div>\n      <div class=\"tap-sugg-block\"><div class=\"tap-sugg-label\">Masters</div><div class=\"tap-sugg-chips\"><a href=\"/?s=feramis\">Feramis Aktas</a><a href=\"/?s=palabiyik\">Yildirim Palabiyik</a><a href=\"/?s=hamid\">Hamid</a></div></div>\n    </div>\n  </div>\n</div>\n<div class=\"tap-overlay tap-mobile-drawer\" id=\"tapMobileNav\" onclick=\"if(event.target===this)tapCloseMobile()\">\n  <aside class=\"tap-nav-drawer\">\n    <header class=\"tap-drawer-head\"><div class=\"tap-drawer-title\">tapad<span>u</span>m</div><button class=\"tap-close-btn\" onclick=\"tapCloseMobile()\">×</button></header>\n    <nav class=\"tap-drawer-nav\">\n      <details><summary>String<span>›</span></summary><div><a href=\"/category/arabic-oud\">Arabic Oud</a><a href=\"/category/turkish-oud\">Turkish Oud</a><a href=\"/category/saz-baglama\">Saz / Baglama</a><a href=\"/category/setar\">Setar</a><a href=\"/category/santur\">Santur</a><a href=\"/category/qanun\">Qanu