              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-actions\">\n  <button class=\"tap-icon\" aria-label=\"Search\" onclick=\"tapOpenSearch()\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n  </button>\n  <a href=\"/my-account\" class=\"tap-icon\" aria-label=\"Account\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-7 8-7s8 3 8 7\"/></svg>\n  </a>\n  <a href=\"/cart\" class=\"tap-icon tap-cart-btn\" aria-label=\"Cart\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg>\n    <span class=\"tap-badge\" id=\"tapCartCount\">2</span>\n  </a>\n  <a href=\"/birthday-sale\" class=\"tap-cta\">Birthday sale →</a>\n  <button class=\"tap-burger\" aria-label=\"Menu\" onclick=\"tapOpenMobile()\"><span></span><span></span><span></span></button>\n</div>\n<style>\n.tap-actions{display:flex;gap:10px;align-items:center;justify-content:flex-end}\n.tap-icon{width:38px;height:38px;border-radius:50%;border:1px solid #E8DFC8;background:#fff;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:#1A1612;position:relative;text-decoration:none;transition:all .18s}\n.tap-icon:hover{border-color:#9A7B3A;color:#9A7B3A;transform:translateY(-1px)}\n.tap-badge{position:absolute;top:-4px;right:-4px;background:#C84B3A;color:#fff;font-size:10px;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;font-family:'Inter',sans-serif}\n.tap-cta{padding:11px 18px;background:linear-gradient(135deg,#9A7B3A,#D4AF37);color:#fff;border-radius:8px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;text-decoration:none;letter-spacing:.02em;transition:transform .18s, box-shadow .18s;white-space:nowrap}\n.tap-cta:hover{transform:translateY(-1px);box-shadow:0 8px 18px -8px rgba(154,123,58,.55);color:#fff}\n.tap-burger{display:none;flex-direction:column;gap:4px;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;border:1px solid #E8DFC8;background:#fff;cursor:pointer}\n.tap-burger span{width:18px;height:2px;background:#1A1612;border-radius:2px}\n@media(max-width:1024px){.tap-cta{display:none}.tap-burger{display:flex}}\n</style>"
              }
            }
