lay:flex;align-items:center;gap:14px;border-bottom:2px solid #1A1612;padding:8px 0 14px;margin-bottom:24px}\n.tap-search-input-wrap input{flex:1;border:0;outline:0;font-family:'Cormorant Garamond',serif;font-size:24px;background:transparent;color:#1A1612}\n.tap-search-input-wrap input::placeholder{color:#8b7f6a;font-style:italic}\n.tap-search-suggest{display:flex;flex-direction:column;gap:18px}\n.tap-sugg-block{display:flex;flex-direction:column;gap:10px}\n.tap-sugg-label{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#8b7f6a;font-weight:600}\n.tap-sugg-chips{display:flex;flex-wrap:wrap;gap:8px}\n.tap-sugg-chips a{padding:8px 14px;border-radius:20px;border:1px solid #E8DFC8;background:#fff;font-size:13px;color:#1A1612;text-decoration:none;transition:all .15s}\n.tap-sugg-chips a:hover{background:#1A1612;color:#fff;border-color:#1A1612}\n.tap-mobile-drawer{padding:0;justify-content:flex-start;align-items:stretch}\n.tap-nav-drawer{background:#fff;width:340px;max-width:100%;height:100%;display:flex;flex-direction:column;transform:translateX(-100%);transition:transform .32s cubic-bezier(.2,.8,.2,1)}\n.tap-mobile-drawer.open .tap-nav-drawer{transform:translateX(0)}\n.tap-drawer-head{display:flex;justify-content:space-between;align-items:center;padding:22px 24px;border-bottom:1px solid #E8DFC8}\n.tap-drawer-title{font-family:'Cormorant Garamond',serif;font-size:24px;color:#1A1612}\n.tap-drawer-title span{color:#9A7B3A;font-style:italic}\n.tap-drawer-nav{flex:1;overflow-y:auto;padding:8px 0}\n.tap-drawer-nav details{border-bottom:1px solid #E8DFC8}\n.tap-drawer-nav summary{display:flex;justify-content:space-between;padding:16px 24px;font-family:'Cormorant Garamond',serif;font-size:18px;cursor:pointer;list-style:none;color:#1A1612}\n.tap-drawer-nav summary::-webkit-details-marker{display:none}\n.tap-drawer-nav summary span{color:#8b7f6a;transition:transform .2s}\n.tap-drawer-nav details[open] summary span{transform:rotate(90deg);color:#9A7B3A}\n.tap-drawer-nav details > div{display:flex;flex-direction:column;padding:0 24px 14px}\n.tap-drawer-nav details > div a{padding:8px 0;color:#3a342c;text-decoration:none;font-size:14px}\n.tap-drawer-nav details > div a:hover{color:#9A7B3A}\n.tap-drawer-flat{display:block;padding:16px 24px;font-family:'Cormorant Garamond',serif;font-size:18px;color:#1A1612;text-decoration:none;border-bottom:1px solid #E8DFC8}\n.tap-drawer-flat:hover{color:#9A7B3A;background:#FAF6EE}\nbody.tap-locked{overflow:hidden}\n</style>\n<script>\nfunction tapOpenSearch(){document.getElementById('tapSearchOverlay').classList.add('open');document.body.classList.add('tap-locked');setTimeout(()=>document.getElementById('tapSearchInput').focus(),60);}\nfunction tapCloseSearch(){document.getElementById('tapSearchOverlay').classList.remove('open');document.body.classList.remove('tap-locked');}\nfunction tapOpenMobile(){document.getElementById('tapMobileNav').classList.add('open');document.body.classList.add('tap-locked');}\nfunction tapCloseMobile(){document.getElementById('tapMobileNav').classList.remove('open');document.body.classList.remove('tap-locked');}\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){tapCloseSearch();tapCloseMobile();}});\ndocument.getElementById('tapSearchInput')?.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.value.trim()){window.location.href='/?s='+encodeURIComponent(e.target.value.trim());}});\n</script>"
