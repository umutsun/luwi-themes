{
  "version": "0.4",
  "title": "Tapadum — Footer",
  "type": "footer",
  "content": [
    {
      "id": "tap_newsletter",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FAF6EE",
        "padding": { "unit": "px", "top": "64", "right": "32", "bottom": "64", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_news_col",
          "elType": "column",
          "settings": { "_column_size": 100, "content_position": "center" },
          "elements": [
            {
              "id": "tap_news_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-newsletter\">\n  <span class=\"tap-news-eyebrow\">Atelier dispatch</span>\n  <h2 class=\"tap-news-title\">News from the workshop, twice a month.</h2>\n  <p class=\"tap-news-sub\">New instruments, master interviews, and tuning sessions — straight from Brisighella to your inbox.</p>\n  <form class=\"tap-news-form\" onsubmit=\"event.preventDefault();this.querySelector('button').textContent='✓ Subscribed';setTimeout(()=>this.reset(),2000);\">\n    <input type=\"email\" placeholder=\"your@email.com\" required>\n    <button type=\"submit\">Subscribe →</button>\n  </form>\n  <span class=\"tap-news-fine\">No spam · unsubscribe anytime</span>\n</div>\n<style>\n.tap-newsletter{max-width:640px;margin:0 auto;text-align:center;display:flex;flex-direction:column;gap:14px;align-items:center}\n.tap-news-eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:#9A7B3A}\n.tap-news-title{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:500;color:#1A1612;margin:0;line-height:1.15}\n.tap-news-sub{font-family:'Inter',sans-serif;font-size:15px;color:#3a342c;margin:0;max-width:520px;line-height:1.6}\n.tap-news-form{display:flex;gap:8px;width:100%;max-width:480px;margin-top:12px}\n.tap-news-form input{flex:1;padding:14px 18px;border:1px solid #E8DFC8;border-radius:8px;background:#fff;font-family:'Inter',sans-serif;font-size:14px;color:#1A1612;outline:0;transition:border-color .18s}\n.tap-news-form input:focus{border-color:#9A7B3A}\n.tap-news-form button{padding:14px 24px;background:#1A1612;color:#fff;border:0;border-radius:8px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;cursor:pointer;letter-spacing:.02em;transition:background .18s}\n.tap-news-form button:hover{background:#9A7B3A}\n.tap-news-fine{font-family:'JetBrains Mono',monospace;font-size:11px;color:#8b7f6a;letter-spacing:.06em}\n@media(max-width:600px){.tap-news-title{font-size:32px}.tap-news-form{flex-direction:column}}\n</style>"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "tap_footer_top",
      "elType": "section",
      "settings": {
        "structure": "44",
        "background_background": "classic",
        "background_color": "#1A1612",
        "padding": { "unit": "px", "top": "72", "right": "32", "bottom": "48", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 },
        "gap": "extended"
      },
      "elements": [
        {
          "id": "tap_foot_brand",
          "elType": "column",
          "settings": { "_column_size": 30 },
          "elements": [
            {
              "id": "tap_foot_brand_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-foot-brand\">\n  <a href=\"/\" class=\"tap-foot-logo\">tapad<span>u</span>m</a>\n  <p>Master luthiers from Istanbul, Tehran &amp; Cairo — atelier in Brisighella, Italy. Every instrument signed, tuned and packed by hand.</p>\n  <div class=\"tap-foot-contact\">\n    <a href=\"tel:+393479746257\">+39 347 974 6257</a>\n    <a href=\"mailto:info@tapadum.com\">info@tapadum.com</a>\n    <span>Via degli Asini, 12 · Brisighella, RA</span>\n  </div>\n  <div class=\"tap-foot-social\">\n    <a href=\"#\" aria-label=\"Instagram\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M17.5 6.5h.01\"/></svg></a>\n    <a href=\"#\" aria-label=\"YouTube\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49 49 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49 49 0 0 1-16.2 0A2 2 0 0 1 2.5 17\"/><path d=\"m10 15 5-3-5-3z\" fill=\"currentColor\"/></svg></a>\n    <a href=\"#\" aria-label=\"Spotify\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M8 11.5c4-1 8-1 11.5 1\"/><path d=\"M8 14.5c3-1 6-1 9 1\"/><path d=\"M8 8.5c5-1 10-1 13.5 2\"/></svg></a>\n    <a href=\"#\" aria-label=\"WhatsApp\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 21l1.5-4.5a8.5 8.5 0 1 1 3 3L3 21\"/><path d=\"M9 10s.5 2 1.5 3 3 1.5 3 1.5l1.5-1.5L17 14l-.5 1.5s-1.5 1.5-3 1.5-4.5-1.5-6-3.5S6 9 6 8s1.5-1.5 1.5-1.5L9 8.5z\"/></svg></a>\n  </div>\n</div>\n<style>\n.tap-foot-brand{display:flex;flex-direction:column;gap:18px;color:#a89d85}\n.tap-foot-logo{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:36px;color:#fff;text-decoration:none;letter-spacing:-.5px;line-height:1}\n.tap-foot-logo span{color:#D4AF37;font-style:italic}\n.tap-foot-brand p{font-family:'Inter',sans-serif;font-size:14px;line-height:1.7;color:#a89d85;margin:0}\n.tap-foot-contact{display:flex;flex-direction:column;gap:6px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.04em}\n.tap-foot-contact a{color:#fff;text-decoration:none}\n.tap-foot-contact a:hover{color:#D4AF37}\n.tap-foot-contact span{color:#a89d85}\n.tap-foot-social{display:flex;gap:10px;margin-top:6px}\n.tap-foot-social a{width:36px;height:36px;border-radius:50%;border:1px solid #3a342c;display:inline-flex;align-items:center;justify-content:center;color:#a89d85;text-decoration:none;transition:all .18s}\n.tap-foot-social a:hover{border-color:#D4AF37;color:#D4AF37;transform:translateY(-2px)}\n</style>"
              }
            }
          ]
        },
        {
          "id": "tap_foot_col_shop",
          "elType": "column",
          "settings": { "_column_size": 24 },
          "elements": [
            {
              "id": "tap_foot_shop_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-foot-col\"><h6>Shop</h6><ul><li><a href=\"/category/string\">String instruments</a></li><li><a href=\"/category/percussions\">Percussions</a></li><li><a href=\"/category/bowed\">Bowed</a></li><li><a href=\"/category/winds\">Winds</a></li><li><a href=\"/category/accessories\">Accessories</a></li><li><a href=\"/customs\">Customs</a></li><li><a href=\"/birthday-sale\" class=\"hot\">Birthday sale</a></li></ul></div><style>.tap-foot-col h6{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#fff;font-weight:600;margin:0 0 18px;border-bottom:1px solid #3a342c;padding-bottom:12px}.tap-foot-col ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}.tap-foot-col a{color:#a89d85;text-decoration:none;font-family:'Inter',sans-serif;font-size:13px;transition:color .15s}.tap-foot-col a:hover{color:#fff}.tap-foot-col a.hot{color:#D4AF37}</style>"
              }
            }
          ]
        },
        {
          "id": "tap_foot_col_atelier",
          "elType": "column",
          "settings": { "_column_size": 23 },
          "elements": [
            {
              "id": "tap_foot_atelier_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-foot-col\"><h6>Atelier</h6><ul><li><a href=\"/about\">Our story</a></li><li><a href=\"/masters\">Master luthiers</a></li><li><a href=\"/journal\">Journal</a></li><li><a href=\"/academy\">Academy</a></li><li><a href=\"/visit\">Visit Brisighella</a></li><li><a href=\"/press\">Press</a></li></ul></div>"
              }
            }
          ]
        },
        {
          "id": "tap_foot_col_help",
          "elType": "column",
          "settings": { "_column_size": 23 },
          "elements": [
            {
              "id": "tap_foot_help_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-foot-col\"><h6>Help</h6><ul><li><a href=\"/shipping\">Shipping &amp; delivery</a></li><li><a href=\"/returns\">Returns &amp; warranty</a></li><li><a href=\"/care\">Instrument care</a></li><li><a href=\"/track-order\">Track your order</a></li><li><a href=\"/contact\">Contact</a></li><li><a href=\"/faq\">FAQ</a></li></ul></div>"
              }
            }
          ]
        }
      ]
    },

    {
      "id": "tap_footer_bottom",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#0e0a06",
        "padding": { "unit": "px", "top": "20", "right": "32", "bottom": "20", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_foot_bot_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_foot_bot_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-foot-bot\">\n  <div class=\"tap-foot-bot-l\">\n    <span>© 2025 Tapadum SRL · P.IVA 02145990394</span>\n    <a href=\"/privacy\">Privacy</a>\n    <a href=\"/terms\">Terms</a>\n    <a href=\"/cookies\">Cookies</a>\n  </div>\n  <div class=\"tap-foot-bot-r\">\n    <span>Secure payments</span>\n    <span class=\"tap-pay\">VISA</span><span class=\"tap-pay\">MC</span><span class=\"tap-pay\">AMEX</span><span class=\"tap-pay\">PayPal</span><span class=\"tap-pay\">SEPA</span>\n  </div>\n</div>\n<style>\n.tap-foot-bot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.04em;color:#6b6151}\n.tap-foot-bot-l{display:flex;gap:18px;align-items:center;flex-wrap:wrap}\n.tap-foot-bot-l a{color:#6b6151;text-decoration:none}\n.tap-foot-bot-l a:hover{color:#D4AF37}\n.tap-foot-bot-r{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.tap-pay{padding:4px 8px;background:#1A1612;border:1px solid #3a342c;border-radius:4px;color:#a89d85;font-size:10px;font-weight:600;letter-spacing:.08em}\n@media(max-width:768px){.tap-foot-bot{justify-content:center;text-align:center}}\n</style>"
              }
            }
          ]
        }
      ]
    }
  ]
}
