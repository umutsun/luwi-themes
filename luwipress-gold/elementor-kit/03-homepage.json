          "elements": [
            {
              "id": "tap_infobar_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-infobar\">\n  <div class=\"tap-info-item\"><span class=\"ic\">⚙</span><div><strong>Hand-tuned</strong><span>Before every dispatch</span></div></div>\n  <div class=\"tap-info-item\"><span class=\"ic\">✈</span><div><strong>Worldwide DHL</strong><span>Insured · 3–7 days</span></div></div>\n  <div class=\"tap-info-item\"><span class=\"ic\">↺</span><div><strong>14-day returns</strong><span>No questions asked</span></div></div>\n  <div class=\"tap-info-item\"><span class=\"ic\">★</span><div><strong>4.9 / 5</strong><span>1,287 verified reviews</span></div></div>\n</div>\n<style>\n.tap-infobar{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;color:#fff}\n.tap-info-item{display:flex;gap:14px;align-items:center}\n.tap-info-item .ic{width:42px;height:42px;border-radius:50%;background:rgba(212,175,55,.12);border:1px solid rgba(212,175,55,.3);display:flex;align-items:center;justify-content:center;font-size:18px;color:#D4AF37;flex-shrink:0}\n.tap-info-item strong{display:block;font-family:'Inter',sans-serif;font-size:14px;font-weight:600;color:#fff;line-height:1.3}\n.tap-info-item span{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:#a89d85}\n@media(max-width:768px){.tap-infobar{grid-template-columns:repeat(2,1fr);gap:18px}}\n</style>"
