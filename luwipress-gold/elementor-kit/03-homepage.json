                  { "_id": "atel_b3", "title": "Worldwide insured shipping.", "body": "DHL Express in custom-built crates · 3–7 working days." },
                  { "_id": "atel_b4", "title": "Lifetime support.",            "body": "Free maintenance for two years · paid service forever after." }
                ]
