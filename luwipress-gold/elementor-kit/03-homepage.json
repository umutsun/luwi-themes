          "elements": [
            {
              "id": "tap_prod_head",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-section-head\">\n  <div class=\"tap-section-head-l\"><span class=\"tap-eyebrow\">— Birthday sale · until Nov 30</span><h2 class=\"tap-section-title\">Best-selling instruments<br><em>up to −27% off.</em></h2></div>\n  <div class=\"tap-section-head-r\"><div class=\"tap-pills\"><a class=\"on\" href=\"#\">All</a><a href=\"#\">String</a><a href=\"#\">Percussions</a><a href=\"#\">Bowed</a><a href=\"#\">Winds</a></div><a href=\"/shop\" class=\"tap-btn-link\">View all 240 →</a></div>\n</div>\n<style>\n.tap-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:48px;flex-wrap:wrap}\n.tap-section-title{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:48px;line-height:1.1;letter-spacing:-.5px;color:#1A1612;margin:8px 0 0}\n.tap-section-title em{font-style:italic;color:#9A7B3A}\n.tap-section-head-r{display:flex;flex-direction:column;gap:14px;align-items:flex-end}\n.tap-pills{display:flex;gap:6px;flex-wrap:wrap}\n.tap-pills a{padding:8px 14px;border-radius:20px;border:1px solid #E8DFC8;background:#fff;font-family:'Inter',sans-serif;font-size:12px;color:#3a342c;text-decoration:none;transition:all .15s;letter-spacing:.02em}\n.tap-pills a:hover{border-color:#9A7B3A;color:#9A7B3A}\n.tap-pills a.on{background:#1A1612;border-color:#1A1612;color:#fff}\n@media(max-width:768px){.tap-section-title{font-size:34px}.tap-section-head-r{align-items:flex-start;width:100%}}\n</style>"
              }
            },
            {
              "id": "tap_prod_grid",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[products limit=\"8\" columns=\"4\" orderby=\"popularity\" class=\"tap-products\"]"
              }
            },
            {
              "id": "tap_prod_grid_fallback",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n/* Style WooCommerce product grid OR fallback static cards */\n.tap-products .products,.tap-products-static{display:grid !important;grid-template-columns:repeat(4,1fr) !important;gap:20px;list-style:none;padding:0;margin:0}\n.tap-products .product,.tap-prod-card{background:#fff;border-radius:8px;overflow:hidden;border:1px solid #f0e6d0;position:relative;display:flex !important;flex-direction:column;transition:transform .35s,box-shadow .35s}\n.tap-products .product:hover,.tap-prod-card:hover{transform:translateY(-3px);box-shadow:0 20px 50px -22px rgba(60,40,0,.25)}\n.tap-products .woocommerce-loop-product__title{font-family:'Cormorant Garamond',serif !important;font-size:18px !important;font-weight:500 !important;color:#1A1612;padding:14px 16px 4px !important;line-height:1.3}\n.tap-products .price{padding:0 16px 14px !important;font-family:'Cormorant Garamond',serif;font-size:18px;color:#1A1612}\n.tap-products .price del{color:#8b7f6a;font-size:14px;margin-right:6px}\n.tap-products .price ins{text-decoration:none;color:#9A7B3A;font-weight:600}\n.tap-products .button,.tap-products .added_to_cart{display:none !important}\n.tap-products .onsale{position:absolute;top:14px;left:14px;background:#C84B3A;color:#fff;padding:4px 10px;border-radius:20px;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;letter-spacing:.08em;z-index:2}\n.tap-products img{aspect-ratio:1/1;object-fit:cover;width:100%}\n@media(max-width:1024px){.tap-products .products,.tap-products-static{grid-template-columns:repeat(2,1fr) !important}}\n@media(max-width:600px){.tap-products .products,.tap-products-static{grid-template-columns:1fr !important}}\n\n/* Fallback static (if Woo not active) */\n.tap-prod-img{aspect-ratio:1/1;background:linear-gradient(135deg,#f0e6d0,#d4c19a);position:relative;display:flex;align-items:center;justify-content:center}\n.tap-prod-img.b{background:linear-gradient(135deg,#3d2f1f,#6b4a2c)}\n.tap-prod-img.c{background:linear-gradient(135deg,#8b5a2c,#c89a5a)}\n.tap-prod-img.d{background:linear-gradient(135deg,#5a3a2a,#a87a4a)}\n.tap-prod-img.e{background:linear-gradient(135deg,#d4b97a,#7a5a2c)}\n.tap-prod-img.f{background:linear-gradient(135deg,#6b4a2c,#a87a4a)}\n.tap-prod-img.g{background:linear-gradient(135deg,#5a3a2a,#c89a5a)}\n.tap-prod-img.h{background:linear-gradient(135deg,#8b6a3a,#d4b97a)}\n.tap-prod-img .pl{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;color:rgba(255,255,255,.45);text-transform:uppercase;text-align:center;padding:0 14px}\n.tap-badge-sale{position:absolute;top:14px;left:14px;background:#C84B3A;color:#fff;padding:4px 10px;border-radius:20px;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;letter-spacing:.08em;z-index:2}\n.tap-fav{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.9);border:0;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#3a342c;font-size:14px}\n.tap-fav:hover{color:#C84B3A}\n.tap-prod-meta{padding:18px 18px 16px;display:flex;flex-direction:column;gap:4px;flex:1}\n.tap-prod-cat{font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#9A7B3A}\n.tap-prod-name{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:500;color:#1A1612;line-height:1.3;margin:2px 0;text-wrap:pretty}\n.tap-prod-maker{font-family:'Inter',sans-serif;font-size:12px;font-style:italic;color:#8b7f6a}\n.tap-prod-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:14px}\n.tap-prod-old{font-family:'Inter',sans-serif;font-size:13px;color:#8b7f6a;text-decoration:line-through;margin-right:6px}\n.tap-prod-now{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:500;color:#1A1612}\n.tap-prod-add{width:34px;height:34px;border-radius:50%;border:1px solid #E8DFC8;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#1A1612;font-size:18px;font-weight:300;transition:all .18s}\n.tap-prod-add:hover{background:#9A7B3A;color:#fff;border-color:#9A7B3A;transform:rotate(90deg)}\n</style>"
