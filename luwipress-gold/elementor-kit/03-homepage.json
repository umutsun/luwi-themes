            {
              "id": "tap_cat_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-section-head\">\n  <div><span class=\"tap-eyebrow\">— Browse by family</span><h2 class=\"tap-section-title\">Pick the voice<br>you're looking for.</h2></div>\n  <a href=\"/shop\" class=\"tap-btn-link\">All categories →</a>\n</div>\n<div class=\"tap-cat-grid\">\n  <a href=\"/category/string\" class=\"tap-cat\" style=\"background:linear-gradient(135deg,#d4b97a,#7a5a2c)\"><span class=\"tap-cat-eb\">62 instruments</span><h3>String</h3><span class=\"tap-cat-sub\">Oud · Saz · Setar · Tanbur · Kanun · Santur</span><span class=\"tap-cat-arrow\">→</span></a>\n  <a href=\"/category/percussions\" class=\"tap-cat\" style=\"background:linear-gradient(135deg,#3d2f1f,#7a5a2c)\"><span class=\"tap-cat-eb\">48 instruments</span><h3>Percussions</h3><span class=\"tap-cat-sub\">Darbuka · Bendir · Riq · Handpan · Steel Tongue</span><span class=\"tap-cat-arrow\">→</span></a>\n  <a href=\"/category/bowed\" class=\"tap-cat\" style=\"background:linear-gradient(135deg,#5a3a2a,#c89a5a)\"><span class=\"tap-cat-eb\">28 instruments</span><h3>Bowed</h3><span class=\"tap-cat-sub\">Kemence · Kamancheh · Kabak Kemane</span><span class=\"tap-cat-arrow\">→</span></a>\n  <a href=\"/category/winds\" class=\"tap-cat\" style=\"background:linear-gradient(135deg,#2a3d3a,#7aa494)\"><span class=\"tap-cat-eb\">36 instruments</span><h3>Winds</h3><span class=\"tap-cat-sub\">Ney · Duduk · Kaval · Mey · Zurna</span><span class=\"tap-cat-arrow\">→</span></a>\n</div>\n<style>\n.tap-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.tap-cat{display:flex;flex-direction:column;justify-content:flex-end;aspect-ratio:3/4;padding:24px;border-radius:8px;color:#fff;text-decoration:none;position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease}\n.tap-cat::before{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.55),transparent 60%);pointer-events:none}\n.tap-cat:hover{transform:translateY(-6px);box-shadow:0 24px 48px -20px rgba(60,40,0,.5)}\n.tap-cat-eb{position:relative;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:8px}\n.tap-cat h3{position:relative;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:34px;color:#fff;margin:0 0 6px;line-height:1.05}\n.tap-cat-sub{position:relative;font-family:'Inter',sans-serif;font-size:12px;color:rgba(255,255,255,.75);line-height:1.5}\n.tap-cat-arrow{position:absolute;top:24px;right:24px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.15);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;font-size:16px;border:1px solid rgba(255,255,255,.2);transition:all .25s}\n.tap-cat:hover .tap-cat-arrow{background:#fff;color:#1A1612;transform:rotate(-45deg)}\n@media(max-width:1024px){.tap-cat-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:600px){.tap-cat-grid{grid-template-columns:1fr}}\n</style>"
