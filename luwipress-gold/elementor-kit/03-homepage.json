              "settings": {
                "html": "<div class=\"tap-masters-head\">\n  <div><span class=\"tap-eyebrow\" style=\"color:#D4AF37\">— The hands behind the work</span><h2 class=\"tap-section-title\" style=\"color:#fff\">Master luthiers in the network.</h2></div>\n  <a href=\"/masters\" class=\"tap-btn-link\" style=\"color:#fff;border-color:#fff\">All 26 masters →</a>\n</div>\n<div class=\"tap-masters-grid\">\n  <a href=\"/masters/feramis-aktas\" class=\"tap-master\"><div class=\"tap-master-img\" style=\"background:linear-gradient(135deg,#9a7b3a,#d4af37)\">F</div><div class=\"tap-master-meta\"><h4>Feramis Aktas</h4><span class=\"loc\">Istanbul · TR</span><span class=\"spec\">Oud · 28 years</span><span class=\"count\">42 instruments</span></div></a>\n  <a href=\"/masters/yildirim-palabiyik\" class=\"tap-master\"><div class=\"tap-master-img\" style=\"background:linear-gradient(135deg,#5a3a2a,#a87a4a)\">Y</div><div class=\"tap-master-meta\"><h4>Yildirim Palabiyik</h4><span class=\"loc\">Istanbul · TR</span><span class=\"spec\">Saz · Tanbur · 32 years</span><span class=\"count\">68 instruments</span></div></a>\n  <a href=\"/masters/hamid\" class=\"tap-master\"><div class=\"tap-master-img\" style=\"background:linear-gradient(135deg,#3d2f1f,#7a5a2c)\">H</div><div class=\"tap-master-meta\"><h4>Hamid</h4><span class=\"loc\">Tehran · IR</span><span class=\"spec\">Setar · Tar · 24 years</span><span class=\"count\">31 instruments</span></div></a>\n  <a href=\"/masters/golestani\" class=\"tap-master\"><div class=\"tap-master-img\" style=\"background:linear-gradient(135deg,#7a5a3a,#b89a6a)\">A</div><div class=\"tap-master-meta\"><h4>A. Golestani</h4><span class=\"loc\">Tehran · IR</span><span class=\"spec\">Tar · Kamancheh · 35 years</span><span class=\"count\">22 instruments</span></div></a>\n</div>\n<style>\n.tap-masters-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:48px;flex-wrap:wrap}\n.tap-masters-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.tap-master{background:#0e0a06;border:1px solid #3a342c;border-radius:8px;padding:24px;text-decoration:none;display:flex;flex-direction:column;gap:18px;transition:all .3s}\n.tap-master:hover{border-color:#D4AF37;transform:translateY(-4px);background:#15110b}\n.tap-master-img{width:80px;height:80px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:36px;font-weight:500;color:#fff}\n.tap-master-meta h4{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:22px;color:#fff;margin:0 0 4px}\n.tap-master-meta .loc{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#D4AF37;display:block;margin-bottom:8px}\n.tap-master-meta .spec{font-family:'Inter',sans-serif;font-size:13px;color:#a89d85;display:block;margin-bottom:12px;font-style:italic}\n.tap-master-meta .count{font-family:'Inter',sans-serif;font-size:11px;color:#6b6151;border-top:1px solid #3a342c;padding-top:10px;display:block}\n@media(max-width:1024px){.tap-masters-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:600px){.tap-masters-grid{grid-template-columns:1fr}}\n</style>"
