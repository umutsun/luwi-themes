              "settings": {
                "html": "<div class=\"tap-breadcrumb\" style=\"margin-bottom:18px\"><a href=\"/\">Home</a> <span>›</span> <a href=\"/shop\">Shop</a> <span>›</span> <a href=\"/category/turkish-oud\">Turkish Oud</a> <span>›</span> <span>Sultan Turkish Oud</span></div>\n<div class=\"tap-gallery\">\n  <div class=\"tap-gallery-main\" style=\"background:linear-gradient(135deg,#f0e6d0,#d4c19a)\"><span class=\"tap-badge-sale\">−10%</span><span class=\"pl\">Main image · oud face</span></div>\n  <div class=\"tap-gallery-thumbs\"><div class=\"on\" style=\"background:linear-gradient(135deg,#f0e6d0,#d4c19a)\"></div><div style=\"background:linear-gradient(135deg,#d4b97a,#7a5a2c)\"></div><div style=\"background:linear-gradient(135deg,#3d2f1f,#7a5a2c)\"></div><div style=\"background:linear-gradient(135deg,#8b6a3a,#d4b97a)\"></div><div class=\"video\" style=\"background:linear-gradient(135deg,#1A1612,#3a342c)\"><span>▶</span></div></div>\n</div>\n<style>\n.tap-gallery{display:flex;flex-direction:column;gap:14px}\n.tap-gallery-main{aspect-ratio:1/1;border-radius:8px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.tap-gallery-main .pl{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;color:rgba(0,0,0,.3);text-transform:uppercase}\n.tap-gallery-thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}\n.tap-gallery-thumbs > div{aspect-ratio:1/1;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:border-color .18s;position:relative;display:flex;align-items:center;justify-content:center}\n.tap-gallery-thumbs > div.on{border-color:#9A7B3A}\n.tap-gallery-thumbs .video span{color:#fff;font-size:14px}\n</style>"
