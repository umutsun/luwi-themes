            {
              "id": "tap_sp_buy",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-sp\">\n  <span class=\"tap-eyebrow\">— Turkish Oud · by Yildirim Palabiyik</span>\n  <h1 class=\"tap-sp-title\">Sultan Turkish Oud</h1>\n  <div class=\"tap-sp-rating\"><span class=\"stars\">★★★★★</span><span>4.9 · 142 reviews</span></div>\n  <div class=\"tap-sp-price\"><span class=\"old\">€835</span><span class=\"now\">€799</span><span class=\"save\">Save €36</span></div>\n  <p class=\"tap-sp-desc\">A signature instrument from Yildirim's Istanbul workshop — walnut bowl, spruce face, ebony fingerboard. Each oud is hand-tuned and intonated by Yildirim's team in our Brisighella atelier before dispatch.</p>\n  <div class=\"tap-sp-options\">\n    <div class=\"tap-sp-opt\"><label>Wood</label><div class=\"tap-sp-chips\"><button class=\"on\">Walnut</button><button>Mahogany</button><button>Maple</button></div></div>\n    <div class=\"tap-sp-opt\"><label>Tuning</label><div class=\"tap-sp-chips\"><button class=\"on\">Standard (FADGCF)</button><button>Arabic (CFADGC)</button></div></div>\n    <div class=\"tap-sp-opt\"><label>Hard case</label><div class=\"tap-sp-chips\"><button class=\"on\">Included</button><button>Soft bag (−€60)</button></div></div>\n  </div>\n  <div class=\"tap-sp-cta\"><div class=\"tap-qty\"><button>−</button><span>1</span><button>+</button></div><button class=\"tap-btn-primary\" style=\"flex:1\">Add to cart · €799</button></div>\n  <button class=\"tap-sp-buy-now\">Buy now (1-click) →</button>\n  <ul class=\"tap-sp-perks\">\n    <li><span>✓</span><strong>Hand-tuned</strong> in our atelier before shipping</li>\n    <li><span>✈</span><strong>DHL Express worldwide</strong> · ships in 2 days</li>\n    <li><span>↺</span><strong>14-day returns</strong> · no questions asked</li>\n    <li><span>★</span><strong>2-year free service</strong> · lifetime paid support</li>\n  </ul>\n</div>\n<style>\n.tap-sp{display:flex;flex-direction:column;gap:18px;position:sticky;top:120px}\n.tap-sp-title{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:48px;line-height:1.05;color:#1A1612;margin:0;letter-spacing:-.5px}\n.tap-sp-rating{display:flex;gap:10px;align-items:center;font-family:'Inter',sans-serif;font-size:13px;color:#8b7f6a}\n.tap-sp-rating .stars{color:#D4AF37;letter-spacing:2px;font-size:16px}\n.tap-sp-price{display:flex;align-items:baseline;gap:14px;padding:14px 0;border-top:1px solid #E8DFC8;border-bottom:1px solid #E8DFC8}\n.tap-sp-price .old{font-family:'Inter',sans-serif;font-size:18px;color:#8b7f6a;text-decoration:line-through}\n.tap-sp-price .now{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:500;color:#1A1612}\n.tap-sp-price .save{margin-left:auto;background:#C84B3A;color:#fff;padding:4px 12px;border-radius:20px;font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;letter-spacing:.06em}\n.tap-sp-desc{font-family:'Inter',sans-serif;font-size:14px;line-height:1.65;color:#3a342c;margin:0}\n.tap-sp-options{display:flex;flex-direction:column;gap:14px}\n.tap-sp-opt label{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:#8b7f6a;font-weight:600;display:block;margin-bottom:8px}\n.tap-sp-chips{display:flex;flex-wrap:wrap;gap:6px}\n.tap-sp-chips button{padding:8px 14px;border:1px solid #E8DFC8;background:#fff;border-radius:6px;font-family:'Inter',sans-serif;font-size:13px;color:#3a342c;cursor:pointer;transition:all .15s}\n.tap-sp-chips button:hover{border-color:#9A7B3A;color:#9A7B3A}\n.tap-sp-chips button.on{background:#1A1612;border-color:#1A1612;color:#fff}\n.tap-sp-cta{display:flex;gap:10px;margin-top:8px}\n.tap-qty{display:inline-flex;border:1px solid #E8DFC8;border-radius:8px;overflow:hidden}\n.tap-qty button{width:46px;height:46px;border:0;background:#fff;cursor:pointer;color:#1A1612;font-size:16px}\n.tap-qty button:hover{background:#FAF6EE;color:#9A7B3A}\n.tap-qty span{display:inline-flex;align-items:center;justify-content:center;min-width:46px;font-family:'Inter',sans-serif;font-size:14px;font-weight:600;border-left:1px solid #E8DFC8;border-right:1px solid #E8DFC8}\n.tap-sp-buy-now{padding:14px;background:#FAF6EE;border:1px solid #E8DFC8;border-radius:8px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;color:#1A1612;cursor:pointer;letter-spacing:.02em}\n.tap-sp-buy-now:hover{background:#1A1612;color:#fff;border-color:#1A1612}\n.tap-sp-perks{list-style:none;padding:18px 0 0;margin:8px 0 0;border-top:1px solid #E8DFC8;display:flex;flex-direction:column;gap:10px}\n.tap-sp-perks li{display:flex;gap:12px;align-items:center;font-family:'Inter',sans-serif;font-size:13px;color:#3a342c}\n.tap-sp-perks li span{width:30px;height:30px;border-radius:50%;background:#FAF6EE;display:inline-flex;align-items:center;justify-content:center;color:#9A7B3A;font-size:14px;flex-shrink:0}\n.tap-sp-perks strong{font-weight:600;color:#1A1612;margin-right:4px}\n@media(max-width:1024px){.tap-sp{position:static}.tap-sp-title{font-size:36px}}\n</style>"
              }
