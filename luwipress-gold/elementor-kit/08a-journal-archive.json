{
  "version": "0.4",
  "title": "Tapadum — Journal Archive (Theme Builder)",
  "type": "archive",
  "location_settings": {
    "include": [
      { "name": "archive", "sub_name": "all", "value": "" },
      { "name": "archive", "sub_name": "in_category", "value": "" }
    ]
  },
  "content": [
    {
      "id": "tap_arc_hero",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FAF6EE",
        "padding": { "unit": "px", "top": "80", "right": "32", "bottom": "40", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_arc_hero_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_arc_hero_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-breadcrumb\"><a href=\"/\">Home</a> <span>›</span> <span>Journal</span></div><span class=\"tap-eyebrow\" style=\"display:block;margin-top:14px\">— The Tapadum Journal</span><h1 class=\"tap-h1\" style=\"font-size:60px\">Notes from <em>the workshop</em>.</h1><p class=\"tap-lead\" style=\"max-width:640px;margin-top:14px;font-size:18px;color:#5b554c\">Field reports, master interviews, tuning logs. Updated weekly from Brisighella and Anatolia.</p>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_arc_chips",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FAF6EE",
        "padding": { "unit": "px", "top": "0", "right": "32", "bottom": "40", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_arc_chips_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_arc_chips_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-pills tap-pills-scroll\" data-luwi=\"category-chips\"><a class=\"on\" href=\"/journal\">All <span class=\"c\">24</span></a><a href=\"/category/masters\">Masters <span class=\"c\">9</span></a><a href=\"/category/tuning\">Tuning <span class=\"c\">6</span></a><a href=\"/category/field-reports\">Field reports <span class=\"c\">5</span></a><a href=\"/category/repair\">Repair <span class=\"c\">4</span></a></div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_arc_featured",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "60", "right": "32", "bottom": "40", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 },
        "structure": "20"
      },
      "elements": [
        {
          "id": "tap_arc_feat_col1",
          "elType": "column",
          "settings": { "_column_size": 60 },
          "elements": [
            {
              "id": "tap_arc_feat_img",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<a href=\"#featured-post\" class=\"tap-jnl tap-jnl-feat\"><div class=\"tap-jnl-img\" style=\"aspect-ratio:4/3;background:linear-gradient(135deg,#3a2818,#6a4022);position:relative;border-radius:6px\"><span class=\"tap-chip\" style=\"position:absolute;top:14px;left:14px;background:rgba(27,28,28,.78);color:#fff\">Featured</span></div></a>"
              }
            }
          ]
        },
        {
          "id": "tap_arc_feat_col2",
          "elType": "column",
          "settings": { "_column_size": 40 },
          "elements": [
            {
              "id": "tap_arc_feat_meta",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-jnl-meta\" style=\"display:flex;flex-direction:column;gap:14px;padding:24px 0\"><span class=\"tap-eyebrow\">Masters · 6 min read</span><h2 class=\"tap-h2\" style=\"font-size:34px\">A week with <em>Cengiz Yildirim</em> · Istanbul</h2><p class=\"tap-lead\" style=\"font-size:16px;color:#5b554c\">In which we learn that a soundboard is mostly a question of patience, and patience is mostly a question of coffee.</p><div class=\"tap-byline\" style=\"display:flex;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#a89368\"><span>Apr 28, 2026</span><span>·</span><span>Marco T.</span></div><a href=\"#\" class=\"tap-cta-link\">Read story →</a></div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_arc_loop",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "20", "right": "32", "bottom": "40", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_arc_loop_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_arc_loop_widget",
              "elType": "widget",
              "widgetType": "posts",
              "settings": {
                "posts_per_page": 9,
                "skin": "classic",
                "columns": 3,
                "image_size": "medium_large",
                "show_excerpt": "yes",
                "excerpt_length": 22,
                "show_meta_data": ["date", "author"],
                "show_read_more": "yes",
                "read_more_text": "Read →",
                "_luwi_note": "On mobile (≤768px), CSS overrides switch to image-left list rows; see mobile-spec/styles.css .post-list-row pattern."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_arc_more",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "20", "right": "32", "bottom": "120", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1372 }
      },
      "elements": [
        {
          "id": "tap_arc_more_col",
          "elType": "column",
          "settings": { "_column_size": 100, "align": "center" },
          "elements": [
            {
              "id": "tap_arc_more_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"text-align:center\"><a href=\"#\" class=\"tap-btn-outline\" data-luwi=\"load-more\" data-target=\".elementor-posts-container\">Load 9 more posts</a></div>"
              }
            }
          ]
        }
      ]
    }
  ],
  "page_settings": { "template": "elementor_header_footer" },
  "_luwipress_notes": {
    "import_target": "Templates → Theme Builder → Archive → Add New → Import",
    "conditions": "Display on: All Archives  +  Exclude: Product archives (handled by Woo template 04-shop)",
    "wp_settings": "Settings → Reading → Posts page = `Journal`",
    "categories_required": ["masters", "tuning", "field-reports", "repair"],
    "fallback": "If using LuwiPress Free (no Theme Builder Archive), import as Page template instead and assign to /journal slug; rely on default category.php for category archives."
  }
}
