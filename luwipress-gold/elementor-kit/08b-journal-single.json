{
  "version": "0.4",
  "title": "Tapadum — Journal Single Post (Theme Builder)",
  "type": "single",
  "location_settings": {
    "include": [
      { "name": "singular", "sub_name": "post", "value": "" }
    ]
  },
  "content": [
    {
      "id": "tap_sg_progress",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true },
        "content_width": { "unit": "px", "size": 1920 },
        "css_classes": "tap-progress-host"
      },
      "elements": [
        {
          "id": "tap_sg_progress_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_progress_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-reading-progress\" data-luwi=\"reading-progress\" style=\"position:sticky;top:0;height:2px;background:#eae3d4;z-index:50\"><span class=\"tap-rp-bar\" style=\"display:block;height:100%;width:0;background:#735c00;transition:width .15s linear\"></span></div><script>(()=>{const b=document.querySelector('.tap-rp-bar');if(!b)return;const u=()=>{const h=document.documentElement;const p=h.scrollTop/(h.scrollHeight-h.clientHeight);b.style.width=Math.min(100,Math.max(0,p*100))+'%'};addEventListener('scroll',()=>requestAnimationFrame(u),{passive:true});u();})();</script>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_cover",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#3a2818",
        "min_height": { "unit": "px", "size": 480 },
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
      },
      "elements": [
        {
          "id": "tap_sg_cover_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_cover_img",
              "elType": "widget",
              "widgetType": "theme-post-featured-image",
              "settings": {
                "image_size": "full",
                "_luwi_note": "fetchpriority=high added via theme filter wp_get_attachment_image_attributes for in-loop hero context"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_meta",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "60", "right": "32", "bottom": "20", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 820 }
      },
      "elements": [
        {
          "id": "tap_sg_meta_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_meta_html_top",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[tapadum_post_meta]",
                "_luwi_note": "Custom shortcode rendering: <div class=\"tap-post-meta\"><span class=\"tap-cat\">{primary_cat}</span> · <span>{reading_time} min read</span> · <span>{post_date}</span></div>"
              }
            },
            {
              "id": "tap_sg_title",
              "elType": "widget",
              "widgetType": "theme-post-title",
              "settings": {
                "size": "xl",
                "header_size": "h1",
                "title_color": "#1B1C1C",
                "typography_typography": "custom",
                "typography_font_family": "Playfair Display",
                "typography_font_size": { "unit": "px", "size": 56 },
                "typography_font_weight": "500",
                "typography_letter_spacing": { "unit": "px", "size": -1 },
                "typography_line_height": { "unit": "em", "size": 1.05 }
              }
            },
            {
              "id": "tap_sg_excerpt",
              "elType": "widget",
              "widgetType": "theme-post-excerpt",
              "settings": {
                "_luwi_note": "Renders post excerpt as deck/lede paragraph",
                "css_classes": "tap-lead"
              }
            },
            {
              "id": "tap_sg_byline",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-byline-card\" style=\"display:flex;gap:12px;align-items:center;padding-top:18px;margin-top:18px;border-top:1px solid #eae3d4\"><div class=\"tap-avatar\" style=\"width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#3d2f1f,#7a5a2c)\"></div><div><div style=\"font-family:Playfair Display,serif;font-size:15px\">[author_name]</div><div style=\"font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#a89368;text-transform:uppercase\">[author_role] · Brisighella</div></div></div>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_body",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "40", "right": "32", "bottom": "40", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 720 }
      },
      "elements": [
        {
          "id": "tap_sg_body_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_content",
              "elType": "widget",
              "widgetType": "theme-post-content",
              "settings": {
                "css_classes": "tap-entry-content",
                "_luwi_note": "Drop-cap on first <p> via .tap-entry-content > p:first-of-type::first-letter; pull-quote via Gutenberg quote block; figures auto loading=lazy"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_pullquote_demo",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FAF6EE",
        "padding": { "unit": "px", "top": "60", "right": "32", "bottom": "60", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 820 }
      },
      "elements": [
        {
          "id": "tap_sg_pq_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_pq_html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<blockquote class=\"tap-pullquote\" style=\"font-family:Playfair Display,serif;font-style:italic;font-size:32px;line-height:1.3;color:#735c00;text-wrap:balance;margin:0\">[Pull-quote inserted via Gutenberg quote block — design system styles it automatically]</blockquote>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_author",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#1B1C1C",
        "padding": { "unit": "px", "top": "60", "right": "32", "bottom": "60", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 820 }
      },
      "elements": [
        {
          "id": "tap_sg_author_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_author_html",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[tapadum_author_card]",
                "_luwi_note": "Custom shortcode: avatar + name + role (ACF user-meta) + bio (description) + 'Visit author archive →' link"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tap_sg_related",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_color": "#FFFFFF",
        "padding": { "unit": "px", "top": "80", "right": "32", "bottom": "100", "left": "32", "isLinked": false },
        "content_width": { "unit": "px", "size": 1180 }
      },
      "elements": [
        {
          "id": "tap_sg_related_col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "tap_sg_related_head",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"tap-section-head\"><span class=\"tap-eyebrow\">— Keep reading</span><h2 class=\"tap-h2\" style=\"font-size:32px\">More from <em>the journal</em>.</h2></div>"
              }
            },
            {
              "id": "tap_sg_related_loop",
              "elType": "widget",
              "widgetType": "posts",
              "settings": {
                "posts_per_page": 3,
                "columns": 3,
                "skin": "classic",
                "image_size": "medium_large",
                "show_excerpt": "no",
                "show_meta_data": ["date"],
                "show_read_more": "no",
                "_luwi_note": "Filter via tax_query same primary category, exclude current post — apply via 'elementor/query/related_posts' query ID + pre_get_posts in functions.php"
              }
            }
          ]
        }
      ]
    }
  ],
  "page_settings": { "template": "elementor_header_footer" },
  "_luwipress_notes": {
    "import_target": "Templates → Theme Builder → Single → Add New → Single Post → Import",
    "conditions": "Display on: All Posts (excluding password-protected if needed)",
    "required_shortcodes": [
      "[tapadum_post_meta] — registered in functions.php; outputs primary category, reading time, date",
      "[tapadum_author_card] — avatar + name + role (ACF user) + bio + archive link"
    ],
    "acf_user_fields": [
      "user_role_short — e.g. 'Founder', 'Tuning lead'",
      "user_location_short — e.g. 'Brisighella'"
    ],
    "performance": [
      "Cover image: fetchpriority=high (theme filter on theme-post-featured-image widget)",
      "Reading-progress: throttled to requestAnimationFrame, single passive scroll listener",
      "Related posts: query cached with wp_cache_set, 12h TTL, key includes post_id + lang"
    ],
    "rtl": [
      "Drop-cap disabled in RTL: html[dir='rtl'] .tap-entry-content p:first-of-type::first-letter{all:unset}",
      "Pull-quote serif italic must register Arabic fallback (Reem Kufi italic)",
      "Reading-time string uses _n() for plural rules per locale"
    ]
  }
}
