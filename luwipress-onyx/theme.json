{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "primary",       "color": "#C9A24B", "name": "Champagne gold" },
        { "slug": "primary-light", "color": "#D8B868", "name": "Gold soft" },
        { "slug": "accent",        "color": "#C9A24B", "name": "Gold" },
        { "slug": "ink",           "color": "#F4F1EA", "name": "Text" },
        { "slug": "muted",         "color": "#9A968C", "name": "Muted" },
        { "slug": "faint",         "color": "#6A675F", "name": "Faint" },
        { "slug": "bg",            "color": "#0E0E10", "name": "Onyx (background)" },
        { "slug": "bg-alt",        "color": "#121214", "name": "Background lifted" },
        { "slug": "surface",       "color": "#1B1B1E", "name": "Surface (card)" },
        { "slug": "surface-2",     "color": "#202023", "name": "Surface elevated" },
        { "slug": "black",         "color": "#0E0E10", "name": "Deepest base" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "'Bodoni Moda', Didot, 'Times New Roman', serif", "slug": "serif", "name": "Bodoni Moda" },
        { "fontFamily": "'Nunito', -apple-system, system-ui, sans-serif", "slug": "sans",  "name": "Nunito" }
      ]
    },
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1320px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.65"
    }
  }
}
